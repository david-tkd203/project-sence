# Puerto del servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos Relacional (ORM Sequelize)
# Motor por defecto: sqlite (cero configuración externa, listo para usar)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Configuración alternativa para PostgreSQL o MySQL (descomentar según necesidad):
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sence_db
# DB_USER=postgres
# DB_PASS=secreto
