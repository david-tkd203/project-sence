# Puerto del servidor Express
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos Relacional (ORM Sequelize)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Configuración alternativa para PostgreSQL o MySQL:
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sence_db
# DB_USER=postgres
# DB_PASS=secreto

# Configuración de Seguridad y Autenticación JWT (Módulo #8)
JWT_SECRET=super_clave_secreta_jwt_para_firmar_tokens_sence_2026
JWT_EXPIRES_IN=2h
